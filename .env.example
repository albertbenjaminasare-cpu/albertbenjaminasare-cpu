# GEMINI_API_KEY: Required for Google GenAI / Gemma API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Gemma 4 Model Configuration
GEMMA_4_MODEL="gemma-4-26b-a4b-it"
GEMMA_VISION_MODEL="gemma-4-26b-a4b-it"
GEMMA_REASONING_MODEL="gemma-4-26b-a4b-it"
PRIMARY_MODEL="gemma-4-26b-a4b-it"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://agrivision-cw5i.onrender.com/"

